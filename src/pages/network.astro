---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaptionStrip from '../components/CaptionStrip.astro';
import Instrument from '../components/Instrument.astro';
import NetControls from '../components/NetControls.astro';
import ProfilePlot from '../components/ProfilePlot.astro';
import net from '../data/network-profile.json';

const lethal = net.meta.lethal[net.alphas.indexOf(net.defaultAlpha)]!;
---

<BaseLayout
  title="Power grid · Cascade"
  description="Take out any node and the grid holds. One node — no different to look at — takes the whole thing down."
>
  <section class="page">
    <div class="page-rail">
      <p class="kicker">Cascade · 03</p>
      <a class="rail-link" href="/synthesis">synthesis →</a>
    </div>
    <CaptionStrip />
    <Instrument
      title="Power grid"
      sci="cascading failure · load redistribution"
      stageLabel="Power grid. Click a node, or press Enter, to take it offline. Arrow keys move between nodes."
    >
      <Fragment slot="overlay">
        <span class="stage-ring" data-on="false"></span>
        <span class="stage-cursor" data-on="false"></span>
      </Fragment>
      <ProfilePlot
        slot="plot"
        id="plot"
        kind="live"
        width={460}
        height={430}
        annotation={{ title: `${lethal} of 180 nodes take down more than half` }}
      />
      <NetControls slot="controls" />
    </Instrument>
    <p class="handoff"><a href="/synthesis">next: what you just felt, named →</a></p>
  </section>
</BaseLayout>

<script>
  import { createNetExhibit } from '../scripts/net.ts';
  import { runNetOnRamp, netOnRampComplete } from '../scripts/net-onramp.ts';
  import { NET_SANDBOX } from '../lib/net-config.ts';

  const root = document.getElementById('instrument');
  const strip = document.getElementById('caption');

  if (root && strip) {
    const returning = netOnRampComplete();
    const ex = createNetExhibit(root, {});

    if (returning) {
      // Repeat visits open in the sandbox with a quiet replay affordance.
      ex.setControls('sandbox');
      strip.dataset.beat = 'sandbox';
      strip.querySelector('.cap-lesson')!.textContent = '';
      strip.querySelector('.cap-prompt')!.textContent = NET_SANDBOX.prompt;
      (strip.querySelector('.cap-next') as HTMLButtonElement).hidden = true;
      const replay = strip.querySelector('.cap-skip') as HTMLButtonElement;
      replay.textContent = '▷ replay intro';
      replay.addEventListener('click', () => {
        localStorage.removeItem('cascade.nw.onramp');
        location.reload();
      });
    } else {
      runNetOnRamp(root, ex, strip);
    }
  }
</script>
