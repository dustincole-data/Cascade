---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaptionStrip from '../components/CaptionStrip.astro';
import ControlBar from '../components/ControlBar.astro';
import Instrument from '../components/Instrument.astro';
import SignaturePlot from '../components/SignaturePlot.astro';

const startD = 0.4;
---

<BaseLayout
  title="Forest fire · Cascade"
  description="Below a line a spark fizzles. A hair past it, the same spark takes everything."
>
  <section class="page">
    <p class="kicker">Cascade · 01</p>
    <CaptionStrip />
    <Instrument
      title="Forest fire"
      sci="percolation · von-Neumann spread"
      stageLabel="Forest stage. Click a tree, or press Enter, to spark it."
    >
      <SignaturePlot
        slot="plot"
        id="plot"
        mode="exhibit"
        width={460}
        height={430}
        showCurve={false}
        showScatter={false}
        markerD={startD}
        annotation={{ title: 'd_c ≈ 0.59', sub: ['the same spark', 'now takes everything'] }}
      />
      <ControlBar slot="controls" startD={startD} />
    </Instrument>
    <p class="handoff"><a href="/sandpile">next: criticality →</a></p>
  </section>
</BaseLayout>

<script>
  import { createExhibit } from '../scripts/exhibit.ts';
  import { runOnRamp, onRampComplete } from '../scripts/beats.ts';
  import { SANDBOX_PROMPT, SKIP_D } from '../lib/beats-config.ts';

  const root = document.getElementById('instrument');
  const strip = document.getElementById('caption');

  if (root && strip) {
    const returning = onRampComplete();
    const ex = createExhibit(root, {
      grid: { W: 128, H: 82 },
      seed: 0x0ca5cade,
      startD: returning ? SKIP_D : 0.4,
    });

    if (returning) {
      // Repeat visits open in the sandbox with a quiet replay affordance.
      ex.setControlsMode('sandbox');
      ex.plot.revealCurve();
      strip.dataset.beat = 'sandbox';
      strip.querySelector('.cap-lesson')!.textContent = '';
      strip.querySelector('.cap-prompt')!.textContent = SANDBOX_PROMPT;
      // No on-ramp is running, so the beat rail would be a dead control.
      (strip.querySelector('.cap-next') as HTMLButtonElement).hidden = true;
      const replay = strip.querySelector('.cap-skip') as HTMLButtonElement;
      replay.textContent = '▷ replay intro';
      replay.addEventListener('click', () => {
        localStorage.removeItem('cascade.ff.onramp');
        location.reload();
      });
    } else {
      runOnRamp(root, ex, strip);
    }
  }
</script>
