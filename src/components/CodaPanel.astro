---
/**
 * One board slot (🔒 ticket 03): concept word · hero plot (its real shape, ONE
 * critical feature annotated off the line) · plain line · felt callback ·
 * real-world echo — plus one restrained re-feel. The rhyme lives in identical
 * framing, annotation and colour, never in forcing the shapes to match.
 */
interface Props {
  concept: string;
  hint: string;
  plain: string;
  felt: string;
  echo: string;
}
const { concept, hint, plain, felt, echo } = Astro.props;
---

<article class="coda-panel">
  <p class="coda-concept">{concept}</p>
  <div class="coda-plot"><slot name="plot" /></div>
  <p class="coda-hint" data-js-only>{hint}</p>
  <p class="coda-plain">{plain}</p>
  <p class="coda-felt">{felt}</p>
  <p class="coda-echo">{echo}</p>
</article>
