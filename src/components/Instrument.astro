---
/**
 * The locked instrument chrome (ticket 01): framed panel, quiet head, dark stage
 * beside its signature plot, control bar underneath. Exhibits are rule-sets on
 * this one frame — they fill the plot and controls slots, they never restyle it
 * (spec §10: resist per-exhibit bespoke chrome).
 */
interface Props {
  title: string;
  sci: string;
  stageLabel: string;
}
const { title, sci, stageLabel } = Astro.props;
---

<section class="instrument" id="instrument">
  <div class="inst-head">
    <div class="inst-title">
      <h2>{title}</h2>
      <span class="sci">{sci}</span>
    </div>
  </div>
  <div class="divider"></div>
  <div class="panels">
    <div class="panel stage" data-spot="stage">
      <span class="panel-tag">stage</span>
      <canvas id="stage" tabindex="0" role="application" aria-label={stageLabel}></canvas>
      <slot name="overlay" />
    </div>
    <div class="panel plot">
      <span class="panel-tag">signature</span>
      <slot name="plot" />
    </div>
  </div>
  <slot name="controls" />
</section>
